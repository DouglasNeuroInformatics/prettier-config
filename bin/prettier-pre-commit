#!/bin/sh

# Nothing to do if no added/copied/modified/renamed files are staged
git diff --cached --quiet --diff-filter=ACMR && exit 0

# Prettify all selected files
git diff --cached --name-only --diff-filter=ACMR -z | xargs -0 pnpm exec prettier --ignore-unknown --write

# Add back the modified/prettified files to staging (prettier only touches the
# working tree, so the staged file list is unchanged from above)
git diff --cached --name-only --diff-filter=ACMR -z | xargs -0 git add
